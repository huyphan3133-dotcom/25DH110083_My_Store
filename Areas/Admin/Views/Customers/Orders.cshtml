@model IEnumerable<_25DH110083_My_Store.Models.Order>
@{
    ViewBag.Title = "Orders";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var customer = ViewBag.Customer as _25DH110083_My_Store.Models.Customer;
}

<h2 class="bg-success">ĐƠN HÀNG CỦA: @customer.CustomerName</h2>

<table class="table bg-info">
    <tr class="bg-success">
        <th>Mã đơn</th>
        <th>Ngày đặt</th>
        <th>Tổng tiền</th>
        <th>Trạng thái</th>
        <th></th>
    </tr>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.OrderID</td>
            <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
            <td>@o.OrderTotal</td>
            <td>@o.OrderStatus</td>
            <td>
                @Html.ActionLink("Chi tiết đơn", "Details", "Orders",
                    new { id = o.OrderID, area = "Admin" },
                    new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>

<p>@Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-primary" })</p>

