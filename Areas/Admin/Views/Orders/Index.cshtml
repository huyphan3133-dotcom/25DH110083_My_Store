@using PagedList.Mvc;
@model PagedList.IPagedList<_25DH110083_My_Store.Models.Order>

<link href="~/Content/PagedList.css" rel="stylesheet" />
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">DANH SÁCH ĐƠN HÀNG</h2>

@using (Html.BeginForm("Index", "Orders", FormMethod.Get))
{
    <p>
        Tìm: @Html.TextBox("searchString", ViewBag.SearchString as string)
        <input type="submit" value="Tìm" class="btn btn-primary btn-sm" />
    </p>
}

<table class="table bg-info">
    <tr class="bg-success">
        <th>Mã đơn</th>
        <th>Khách hàng</th>
        <th>
            @Html.ActionLink("Ngày đặt", "Index",
            new { sortOrder = ViewBag.DateSortParm, searchString = ViewBag.SearchString })
    </th>
    <th>Tổng tiền</th>
    <th>Trạng thái</th>
    <th></th>
</tr>
@foreach (var item in Model)
{
    <tr>
        <td>@item.OrderID</td>
        <td>@item.Customer.CustomerName</td>
        <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
        <td>@item.TotalAmount</td>
        <td>@item.OrderStatus</td>
        <td>
            @Html.ActionLink("Chi tiết", "Details", new { id = item.OrderID },
                new { @class = "btn btn-primary btn-sm" })
        </td>
    </tr>
}
</table>

Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount
@Html.PagedListPager(Model, page => Url.Action("Index",
    new { page, sortOrder = ViewBag.CurrentSort, searchString = ViewBag.SearchString }))