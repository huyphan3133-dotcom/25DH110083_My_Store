@{
    // Lấy thông tin giỏ hàng từ session
    var cart = Session["Cart"] as _25DH110083_My_Store.Models.ViewModel.Cart;

    // Tạo đối tượng ViewBag.pmmodel dạng PersonalMenuVM và lưu trong ViewBag
    // Khởi tạo giá trị dựa trên thông tin tài khoản đăng nhập
    ViewBag.pmmodel = new _25DH110083_My_Store.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = User.Identity.IsAuthenticated,
        Username = User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty,
        // Nếu giỏ hàng không rỗng thì gán số lượng mặt hàng trong giỏ cho CartCount
        CartCount = (cart != null && cart.Items.Any()) ? cart.Items.Count() : 0
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ELLA</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #fff;
        }

        .top-banner {
            background: #8fea8f;
            color: #0a6b0a;
            text-align: center;
            padding: 6px 0;
        }

            .top-banner b {
                color: #0000ff;
                font-style: italic;
            }

        .main-nav {
            background: #f8f8f8;
            border-bottom: 1px solid #e7e7e7;
            margin-bottom: 0;
        }

        .navbar-brand {
            font-weight: bold;
            letter-spacing: 2px;
            font-size: 22px;
        }

        .page-body {
            min-height: 450px;
            padding: 20px 0;
        }

        .site-footer {
            background: #d3d3d3;
            padding: 20px 0;
            color: #2a6fb0;
        }

            .site-footer .members {
                font-size: 12px;
            }
    </style>
</head>
<body>

    <!-- ===== HEADER: banner ===== -->
    <div class="top-banner">
        Free ship đơn từ 40k, giảm nhiều hơn cùng <b>FREESHIP XTRA</b>
    </div>

    <!-- ===== HEADER: thanh menu (logo + CategoryMenu + PersonalMenu) ===== -->
    <nav class="navbar navbar-default main-nav">
        <div class="container-fluid">
            <div class="navbar-header">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">ELLA</a>
            </div>

            <!-- CategoryMenu: partial view -->
            @Html.Action("CategoriesMenu", "Home")

            <!-- PersonalMenu: partial view, nhận dữ liệu từ ViewBag.pmmodel -->
            @Html.Partial("PersonalMenuPV", (_25DH110083_My_Store.Models.ViewModel.PersonalMenuVM)ViewBag.pmmodel)
        </div>
    </nav>

    <!-- ===== BODY ===== -->
    <div class="container page-body">
        @RenderBody()
    </div>

    <!-- ===== FOOTER: thông tin đề tài, các thành viên ===== -->
    <footer class="site-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <span>© 2024 - Đề tài: Xây dựng website bán hàng ELLA</span>
                </div>
                <div class="col-md-6 text-right">
                    <strong>Contact</strong>
                    <div class="members">Phan Nhật Huy</div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>