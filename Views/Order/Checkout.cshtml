@model _25DH110083_My_Store.Models.ViewModel.CheckoutVM
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .accountbtn {
        width: 275px;
        height: 40px;
        border: 1px solid #808080;
        margin: 5px;
    }
</style>

<script>
    // Bật chế độ chỉnh sửa địa chỉ giao hàng
    function enableAddressEdit() {
        document.getElementById("shippingAddress").removeAttribute("readonly");
        document.getElementById("newAddressGroup").style.display = "block";
    }

    // Nếu có địa chỉ mới thì gán vào trường ShippingAddress trước khi gửi form
    function updateShippingAddress() {
        var newAddress = document.getElementById("newShippingAddress").value;
        if (newAddress) {
            document.getElementById("shippingAddress").value = newAddress;
        }
    }
</script>

<h2>ĐẶT HÀNG</h2>

@using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <h3>Thông tin đơn hàng</h3>
    <table class="table">
        <thead>
            <tr>
                <th colspan="2">Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CartItems)
            {
                <tr>
                    <td><img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage) ? "~/Content/images/default_img.jpg" : item.ProductImage)" alt="@item.ProductName" style="max-height:60px;" /></td>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0")</td>
                    <td>@item.TotalPrice.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Thông tin giao hàng</h3>

    <!-- Địa chỉ mặc định (chỉ đọc) -->
    <div class="form-group">
        @Html.LabelFor(m => m.ShippingAddress, new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.ShippingAddress, new
            {
                @class = "form-control",
                @readonly = "readonly",
                id = "shippingAddress"
            })
            @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })
            <button type="button" class="btn btn-link" onclick="enableAddressEdit()">Chỉnh sửa</button>
        </div>
    </div>

    <!-- Ô nhập địa chỉ mới (ẩn cho tới khi bấm Chỉnh sửa, không có name nên không được gửi lên) -->
    <div class="form-group" id="newAddressGroup" style="display:none;">
        <label class="control-label col-md-2">Địa chỉ mới</label>
        <div class="col-md-6">
            <input type="text" id="newShippingAddress" class="form-control" />
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.ShippingMethod, new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh") Giao hàng nhanh<br />
            @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm") Giao hàng tiết kiệm<br />
            @Html.ValidationMessageFor(m => m.ShippingMethod, "", new { @class = "text-danger" })
        </div>
    </div>

    <h3>Phương thức thanh toán</h3>
    <div class="form-group">
        @Html.LabelFor(m => m.PaymentMethod, new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt") Tiền mặt<br />
            @Html.RadioButtonFor(m => m.PaymentMethod, "Paypal") Paypal<br />
            @Html.RadioButtonFor(m => m.PaymentMethod, "Mua trước trả sau") Mua trước trả sau<br />
            @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.TotalAmount, new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control", @readonly = "readonly" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-6">
            <input type="submit" value="Đặt hàng" class="btn btn-default accountbtn" onclick="updateShippingAddress()" />
        </div>
    </div>
}