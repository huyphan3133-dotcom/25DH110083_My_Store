@model _25DH110083_My_Store.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .accountbtn {
        width: 275px;
        height: 40px;
        border: 1px solid #808080;
        margin: 5px;
        align-items: center;
    }
</style>

<h2 class="text-center">Đăng nhập</h2>

@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Username, new { @class = "control-label col-md-2" })
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.CustomerPassword, new { @class = "control-label col-md-2" })
        <div class="col-md-4">
            @Html.PasswordFor(m => m.CustomerPassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.CustomerPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-4">
            <input type="submit" value="Đăng nhập" class="btn btn-info accountbtn" />
            <p>Bạn Chưa Có Tài Khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a></p>
        </div>
    </div>
}
