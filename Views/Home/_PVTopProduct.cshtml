@model _25DH110083_My_Store.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight:bold;">Sản phẩm bán chạy</h4>
        <ul class="list-container">
            @foreach (var product in Model.TopProducts)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(string.IsNullOrEmpty(product.ProductImage) ? "~/Content/images/default_img.jpg" : product.ProductImage)" alt="@product.ProductName" />
                        </a>
                    </div>
                    <div>
                        <p class="prodName">@product.ProductName</p>
                        <p class="prodPrice">@product.ProductPrice.ToString("N0") đ</p>
                    </div>
                </li>
            }
        </ul>

        <div class="pagination-container">
            @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails", "Home", new
            {
                id = Model.product.ProductID,
                quantity = Model.quantity,
                page
            }))
        </div>
    </section>
}
