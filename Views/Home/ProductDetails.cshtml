@model _25DH110083_My_Store.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerDetailProduct.css" />
<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />
@if (TempData["CartError"] != null)
{
    <div class="alert alert-danger" style="margin:10px;">@TempData["CartError"]</div>
}
<div class="container-fluid pro">
    <div class="row">

        <!-- Khối bên trái: ảnh sản phẩm -->
        <div class="col-md-3 pro-section">
            <img src="@Url.Content(string.IsNullOrEmpty(Model.product.ProductImage) ? "~/Content/images/default_img.jpg" : Model.product.ProductImage)" alt="@Model.product.ProductName" />
        </div>

        <!-- Khối ở giữa: thông tin sản phẩm -->
        <div class="col-md-5 pro-section">
            <h4><strong>@Model.product.ProductName</strong></h4>
            <p class="pro-sale">Đã bán: @Model.product.OrderDetails.Count</p>
            <p class="pro-price">@Model.product.ProductPrice.ToString("N0") đ</p>
            <p>Tủ sách: @Model.product.Category.CategoryName</p>
            <hr />
            <h5><strong>Mô tả</strong></h5>
            <p>@Model.product.ProductDescription</p>
            <hr />

            <!-- Sản phẩm tương tự -->
            @Html.Partial("_PVRelatedProduct", Model)
        </div>

        <!-- Khối bên phải: số lượng, tạm tính, thêm vào giỏ -->
        <div class="col-md-3 pro-section">
            @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
            {
                @Html.Hidden("id", Model.product.ProductID)

                <h4><strong>Số lượng</strong></h4>
                <p>@Html.TextBox("quantity", Model.quantity, new { @class = "form-control", type = "number", min = 1 })</p>
                <p><input type="submit" value="Cập nhật" class="btn btn-default" /></p>

                <h4><strong>Tạm tính</strong></h4>
                <p>@Model.estimatedValue.ToString("N0") đ</p>

                <p>
                    @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                        new { id = Model.product.ProductID, quantity = Model.quantity },
                        new { @class = "btn btn-info" })
                </p>
            }
            <hr />

            <!-- Sản phẩm bán chạy cùng danh mục -->
            @Html.Partial("_PVTopProduct", Model)
        </div>
    </div>
</div>