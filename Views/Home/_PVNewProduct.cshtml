@model _25DH110083_My_Store.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="container-fluid listProduct">
        <h2>Sản phẩm mới</h2>
        <ul class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(string.IsNullOrEmpty(product.ProductImage) ? "~/Content/images/default_img.jpg" : product.ProductImage)" alt="@product.ProductName" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">@product.ProductPrice.ToString("N0") đ</p>
                        <p class="prodName">@product.ProductName</p>
                        <p class="prodCate">@product.Category.CategoryName</p>
                        <p class="prodSale">Đã bán: @product.OrderDetails.Count</p>
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- Phân trang -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", "Home", new
        {
            page,
            searchTerm = Model.SearchTerm
        }))
    </div>
}
else
{
    <p>Không tìm được sản phẩm nào phù hợp.</p>
}